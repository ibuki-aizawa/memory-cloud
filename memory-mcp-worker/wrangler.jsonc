{
  // Cloudflare Workers の設定ファイル（AWS でいう SAM テンプレートに相当）
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memory-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memory-mcp",
      // `npx wrangler d1 create memory-mcp` の出力に表示される ID を貼り付けてください
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ]
}
